<!doctype html><html lang="fa"><head><meta charset="utf-8"><style>#route1,#route2,#route3{border-top:0}.choice b{font-weight:800}.route-scan{height:3px;background:#d8b57b}
@font-face{font-family:Vazirmatn;src:url('assets/Vazirmatn-500.woff2');font-weight:500}@font-face{font-family:Vazirmatn;src:url('assets/Vazirmatn-800.woff2');font-weight:800}*{box-sizing:border-box}body{margin:0;color:#f7f3ea;background:#111719;font-family:Vazirmatn,sans-serif;font-weight:500}#film{position:relative;width:100%;height:100%;overflow:hidden}.clip{position:absolute;inset:0}.bg{position:absolute;inset:0;background:radial-gradient(ellipse at 15% 20%,#79674755,transparent 62%),#111719}.inner{position:absolute;inset:0}.kicker{position:absolute;right:90px;top:150px;color:#d8b57b;font-size:30px}.title{position:absolute;right:90px;left:90px;top:240px;font-size:108px;line-height:1.35;font-weight:800}.title em{font-style:normal;color:#d8b57b;display:block}.bag{position:absolute;left:80px;top:450px;width:920px;height:920px;object-fit:contain}.outline{position:absolute;left:230px;top:650px;width:620px;height:650px;border:3px solid #d8b57b;border-radius:4px}.choice{position:absolute;right:90px;left:90px;top:780px;border-top:1px solid #d8b57b66;padding:30px 0;display:flex;align-items:center;gap:40px;font-size:57px;font-weight:800}.choice i{font-size:30px;font-style:normal;color:#d8b57b}.choice.two{top:960px}.choice.three{top:1140px}.glass{position:absolute;width:340px;height:340px;left:55px;top:655px;object-fit:contain}.rail{position:absolute;right:130px;top:790px;width:2px;height:570px;background:#d8b57b}.foot{position:absolute;left:90px;right:90px;bottom:170px;font-size:38px;line-height:1.8;color:#c8d0cb}.pill{position:absolute;left:90px;right:90px;top:900px;height:130px;border:2px solid #d8b57b;border-radius:18px;background:#d8b57b}.cta{position:absolute;left:90px;right:90px;top:932px;text-align:center;color:#111719;font-size:53px;font-weight:800}.form{position:absolute;left:135px;right:135px;top:820px}.field{margin-top:65px;color:#f7f3ea;font-size:39px}.line{margin-top:20px;border:1px solid #7b8e8f;border-radius:7px;padding:26px;color:#b8c0bf;font-size:43px}.finish{margin-top:65px;border-radius:8px;background:#d8b57b;padding:27px;color:#111719;text-align:center;font-size:39px;font-weight:800}.glow{position:absolute;left:-400px;top:-200px;width:500px;height:2300px;background:linear-gradient(90deg,transparent,#dbb98040,transparent);transform:rotate(20deg);pointer-events:none}
</style></head><body><div id="film" dir="rtl" data-composition-id="lab" data-width="1080" data-height="1920" data-fps="60" data-duration="12"><div class="bg"></div>
<section class="clip" id="lab-a" data-start="0" data-duration="4"><div class="inner"><div class="kicker">قبل از اینکه بخری</div><div class="title">اول،<em>نیاز تو.</em></div><img class="bag" id="bag" src="assets/t01-charcoal-shopping-bag.png"><div class="outline" id="outline"></div><div id="labChoices"><div class="choice"><i>۰۱</i>نتیجهٔ موردنظر</div><div class="choice two"><i>۰۲</i>کیفیت محصول</div><div class="choice three"><i>۰۳</i>قیمت مناسب</div></div><div class="foot">چی برات مهم‌تره؟</div></div></section>
<section class="clip" id="lab-b" data-start="4" data-duration="4"><div class="inner"><div class="kicker">مسیر انتخاب</div><div class="title">از شناخت،<em>تا تصمیم تو.</em></div><div class="rail" id="rail"></div><div class="choice" id="route1"><i>۰۱</i>نیاز تو</div><div class="choice two" id="route2"><i>۰۲</i>بررسی محصول</div><div class="choice three" id="route3"><i>۰۳</i>تصمیم خودت</div><img class="glass" id="glass" src="assets/t02-brass-magnifying-glass.png"><div class="foot">انتخاب، با توست.</div></div></section>
<section class="clip" id="lab-c" data-start="8" data-duration="4"><div class="inner"><div class="kicker">مشاوره پیش از خرید</div><div class="title">یه گفت‌وگوی کوتاه.<em>برای انتخاب تو.</em></div><div class="pill" id="pill"></div><div class="cta" id="cta">نیاز به مشاوره دارم</div><div class="form" id="form"><div class="field">نام<div class="line">نام شما</div></div><div class="field">شماره موبایل<div class="line" dir="ltr">۰۹…</div></div><div class="finish">ثبت درخواست مشاوره</div></div><div class="foot">از همین‌جا شروع کنیم.</div></div></section><div class="glow" id="light"></div>
</div><script src="assets/gsap.min.js"></script><script>
const t=gsap.timeline({paused:true});gsap.set('#outline',{opacity:0});gsap.set('#labChoices',{opacity:0});gsap.set('#form',{opacity:0});gsap.set('#rail',{scaleY:0,transformOrigin:'top'});gsap.set('#route1,#route2,#route3',{opacity:0});gsap.set('#glass',{opacity:0});
t.to('#bag',{y:-80,scale:.84,duration:1.35,ease:'power2.inOut'},.05)
.to('#labChoices',{opacity:1,duration:.4},1.45).fromTo('#labChoices .choice',{x:60},{x:0,duration:.75,stagger:.35,ease:'power3.out'},1.45)
.to('#bag',{opacity:0,scale:.95,duration:.45},1.5)
.fromTo('#outline',{opacity:0,scale:.66},{opacity:.8,scale:1,duration:.3},1.4)
.to('#outline',{x:-140,y:130,scaleX:1.45,scaleY:.83,transformOrigin:'top left',opacity:0,duration:.65,ease:'power3.inOut'},1.55)
.to('#labChoices .choice',{borderColor:'#d8b57b',duration:.65,stagger:.4},2.3);
t.fromTo('#glass',{opacity:0,y:-120,scale:.8},{opacity:1,y:0,scale:1,duration:.6,ease:'power2.out'},4)
.to('#route1',{opacity:1,duration:.35},4.45).fromTo('#route1',{x:-35},{x:0,duration:.6},4.45)
.to('#glass',{y:180,duration:.65,ease:'power2.inOut'},4.95).to('#route2',{opacity:1,duration:.4},5.3).fromTo('#route2',{x:-35},{x:0,duration:.6},5.3)
.to('#glass',{y:360,duration:.65,ease:'power2.inOut'},5.9).to('#route3',{opacity:1,duration:.4},6.3).fromTo('#route3',{x:-35},{x:0,duration:.6},6.3)
.to('#rail',{scaleY:1,duration:2.8,ease:'none'},4.6)
.to('#glass',{x:-40,y:470,scale:.6,opacity:0,duration:.65},6.95)
.to('#route3',{color:'#d8b57b',duration:.55},7.2);
t.to('#pill',{y:-155,scaleY:6,transformOrigin:'top',borderWidth:0,backgroundColor:'#182528',duration:.8,ease:'power3.inOut'},9.65)
.to('#cta',{y:-220,color:'#d8b57b',duration:.65,ease:'power3.inOut'},9.65)
.to('#form',{opacity:1,duration:.4},9.73).fromTo('#form',{y:70},{y:0,duration:.8,ease:'power3.out'},9.73)
.fromTo('#form .field,#form .finish',{opacity:0,y:35},{opacity:1,y:0,duration:.5,stagger:.16},9.75);
t.fromTo('#light',{x:0,opacity:0},{x:2000,opacity:.7,duration:1.1,ease:'power2.inOut'},1.25).set('#light',{x:0,opacity:0},2.5)
.fromTo('#light',{x:0,opacity:0},{x:2000,opacity:.5,immediateRender:false,duration:1.1,ease:'power2.inOut'},9.55);
window.__timelines=window.__timelines||{};window.__timelines.lab=t;
</script></body></html>